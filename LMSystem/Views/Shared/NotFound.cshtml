@{
    ViewData["Title"] = "Page Not Found";
    var errorMessage = ViewBag.ErrorMessage as string ?? TempData["ErrorMessage"] as string;
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-warning shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Resource Not Found</h3>
                </div>
                <div class="card-body">
                    <p class="lead">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            @errorMessage
                        }
                        else
                        {
                            <text>The page you are looking for does not exist.</text>
                        }
                    </p>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" asp-controller="Books" class="btn btn-primary">
                        <i class="bi bi-arrow-left-circle"></i> Back to Book List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Include Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
